# deployment-state/.env.example — environment keys used by deploy/ and server/
# All *.env files in this directory are placeholders in the delivered copy;
# real values live only in the private backup (not in this repo).

# --- secrets.env: MCP / gateway runtime keys ---
GATEWAY_API_KEY=<your-gateway-api-key>
MCP_SERVICE_API_KEY=<your-mcp-service-api-key>
MCP_API_KEY=<your-mcp-api-key>

# --- e2e-secrets.env: wizard owner setup / runtime API keys ---
WIZARD_OWNER_SETUP_TOKEN=<your-owner-setup-token>
FINAL_RUNTIME_API_KEY=<your-final-runtime-api-key>
NEW_RUNTIME_API_KEY=<your-new-runtime-api-key>

# --- auth-persistent.env: persistent wizard auth state (read by server/wizard/auth_persistent.py) ---
WIZARD_AUTH_BACKEND=<your-auth-backend>
WIZARD_AUTH_TOS_BUCKET=<your-tos-bucket>
WIZARD_AUTH_TOS_KEY=<your-tos-object-key>
WIZARD_AUTH_ENCRYPTION_KEY=<your-encryption-key>

# --- deploy-time infra env (deploy/*.py, read from process env, not from these files) ---
# VOLCENGINE_ACCESS_KEY / VOLCENGINE_SECRET_KEY / VOLCENGINE_REGION / REGION
# WIZARD_IMAGE / TARGET_IMAGE / FRONTDOOR_IMAGE / SAMPLE_RUNTIME_ID
# WIZARD_PUBLIC_ORIGIN / VEADK_FRONTEND_ROLE / VPC_ID / SUBNET_IDS / SECURITY_GROUP_IDS
# CR_REGISTRY_NAME / TOS_BUCKET / TOS_OBJECT_PREFIX / OPENAPI_WORKDIR / SANDBOX_TOOL_ID
