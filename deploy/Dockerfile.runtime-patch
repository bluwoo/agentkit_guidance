# Minimal production patch image built from the current verified Wizard release.
# Replaces application code and the production frontend bundle.
# Registry host supplied via --build-arg REGISTRY_HOST=<your-cr-host>.
ARG REGISTRY_HOST
FROM ${REGISTRY_HOST}/agentkit/agentkit-wizard:0.21.7
WORKDIR /app
RUN python -m pip install --no-cache-dir tos==2.8.7
COPY server/ ./server/
COPY web/dist/ ./web/dist/
ENV WIZARD_VERSION=0.21.10
CMD ["uvicorn", "server.wizard.main:app", "--host", "0.0.0.0", "--port", "8000"]
